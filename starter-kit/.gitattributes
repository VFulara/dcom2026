# Normalise line endings in the repository.
# Shell scripts and Python must stay LF — they run on Linux/macOS.
# PowerShell and batch scripts use CRLF on Windows checkout.
# Everything else normalises to LF.

* text=auto

*.sh         text eol=lf
*.py         text eol=lf
*.js         text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.cds        text eol=lf
*.xml        text eol=lf
*.json       text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.md         text eol=lf
*.properties text eol=lf
*.csv        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.png  binary
*.jpg  binary
*.ico  binary
